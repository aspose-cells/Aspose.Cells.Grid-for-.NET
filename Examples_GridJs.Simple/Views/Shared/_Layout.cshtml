<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Aspose.Cells GridJS examples for ASP.NET Core, React, Vue, Angular, and npm." />
    <title>@ViewData["Title"] · Aspose.Cells GridJS</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
        <div class="site-header__inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img class="brand__logo" src="~/image/aspose-logo.svg" alt="" width="34" height="34" aria-hidden="true" />
                <span>Aspose.Cells GridJS</span>
            </a>
            <nav class="site-nav" aria-label="Primary navigation">
                <a asp-controller="Home" asp-action="Index">Examples</a>
                <a asp-controller="GridJs" asp-action="Index">Razor demo</a>
                <a href="https://docs.aspose.com/cells/net/aspose-cells-gridjs/">Documentation</a>
            </nav>
        </div>
    </header>
    <main id="main-content" class="site-main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <span>&copy; 2026 Aspose.Cells</span>
        <span>One backend, four npm integration examples.</span>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
